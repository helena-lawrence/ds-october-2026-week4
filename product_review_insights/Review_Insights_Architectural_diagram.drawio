<mxfile host="app.diagrams.net" modified="2026-11-01T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="architecture" name="Product Review Insights Architecture"><mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;PRODUCT REVIEW INSIGHTS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;System Architecture · Live Inference &amp;amp; Offline Evaluation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#123D70;strokeColor=#123D70;strokeWidth=2;fontColor=#15304F;fontSize=27;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="25" width="1440" height="85" /></mxCell><mxCell id="user" value="&lt;b&gt;USER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Enters review&lt;br&gt;Chooses prompt technique&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3F7FC;strokeColor=#8BB6DF;strokeWidth=2;fontColor=#15304F;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="210" width="215" height="160" /></mxCell><mxCell id="streamlit" value="&lt;b&gt;STREAMLIT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Frontend · Port 8501&lt;br&gt;Review form and results&lt;br&gt;Displays analysis &amp;amp; judge score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F3FF;strokeColor=#4C9DE0;strokeWidth=2;fontColor=#15304F;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="195" width="300" height="190" /></mxCell><mxCell id="fastapi" value="&lt;b&gt;FASTAPI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Backend · Port 8001&lt;br&gt;POST /analyze · GET /health&lt;br&gt;Pydantic validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8FAF5;strokeColor=#39AD96;strokeWidth=2;fontColor=#15304F;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="725" y="195" width="310" height="190" /></mxCell><mxCell id="azure" value="&lt;b&gt;AZURE OPENAI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Prompting: zero-shot / few-shot / role-based&lt;br&gt;Review analysis → structured JSON&lt;br&gt;LLM-as-Judge → score (1–5) + reason&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF3FF;strokeColor=#548BDA;strokeWidth=2;fontColor=#15304F;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1105" y="195" width="390" height="190" /></mxCell><mxCell id="e1" value="Review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2874B8;strokeWidth=3;fontSize=13;fontColor=#274765;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="streamlit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="HTTP REST request / response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2874B8;strokeWidth=3;fontSize=13;fontColor=#274765;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;" edge="1" parent="1" source="streamlit" target="fastapi"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="HTTPS · API key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2874B8;strokeWidth=3;fontSize=13;fontColor=#274765;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;" edge="1" parent="1" source="fastapi" target="azure"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="sep" value="&lt;b&gt;OFFLINE EVALUATION · Developer-run (not part of every customer request)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E7EDF5;strokeColor=#E7EDF5;strokeWidth=2;fontColor=#15304F;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="460" width="1415" height="50" /></mxCell><mxCell id="dataset" value="&lt;b&gt;LABELLED DATASET&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;labelled_reviews.jsonl&lt;br&gt;20 reviews + expected outputs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3F7FC;strokeColor=#8BB6DF;strokeWidth=2;fontColor=#15304F;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="575" width="310" height="135" /></mxCell><mxCell id="eval" value="&lt;b&gt;evaluate.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Runs 3 prompt techniques&lt;br&gt;Checks aspects, rating, recommendation&lt;br&gt;Compares human and LLM judge scores&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3F7FC;strokeColor=#8BB6DF;strokeWidth=2;fontColor=#15304F;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="515" y="565" width="465" height="155" /></mxCell><mxCell id="reports" value="&lt;b&gt;EVALUATION REPORTS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;predictions.csv · per-review checks&lt;br&gt;accuracy.csv · aggregate metrics&lt;br&gt;judge_agreement.csv · human vs AI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0F9F4;strokeColor=#65B38C;strokeWidth=2;fontColor=#15304F;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" v